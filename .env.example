# Case File reads two things from here, and neither is required to run it.
# The file itself must exist, because the npm scripts pass --env-file=.env,
# which errors if it is missing. Empty is fine.

# PORT=4001


# ---------------------------------------------------------------------------
# The clerk — the only part of this app that talks to anything off-machine.
# ---------------------------------------------------------------------------
# With no key below, the clerk is off and the app is unchanged: no brief on the
# dashboard, no chat card, no filing button on the scratchpad, no deck writing,
# and no request to anywhere. That is the default, and turning it on is
# deliberately a thing you do by hand in this file.
#
# What is sent when it IS on: the text you are filing, your case names, the
# entries in them and the courses on your timetable. Nothing at any other time.
#
# One key is a complete installation. Both is better — each job goes to the
# provider that suits it, and a rate limit on one does not take the other down.

# aistudio.google.com — free tier, huge context window. Used for filing and
# for writing decks, because a syllabus plus your whole archive has to fit in
# one call and Groq's token-per-minute cap is too low for that.
# Limited by requests per MINUTE, which normal use never reaches.
# GEMINI_API_KEY=

# console.groq.com — free tier, 1000 requests a day, 8000 tokens a minute.
# Used for the brief and the chat card: it answered in under 100ms in testing,
# which is most of what makes those two feel good. The token-per-minute cap is
# why the long jobs go to Gemini instead.
# GROQ_API_KEY=

# If both are set, each job goes to the one that suits it AND falls over to
# the other when it hits a limit — the two free tiers are capped along
# different axes, so the wall one hits is usually one the other would not
# have noticed. One key alone is still a complete installation.

# openrouter.ai — the fallback, used only if neither of the above is set.
# OPENROUTER_API_KEY=
# CLERK_OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Pin every job to one provider: gemini | groq | openrouter. Worth setting
# when you want to know whether an odd answer is the model or the prompt.
# A pinned provider never falls over to another one — that is the point of it.
# CLERK_PROVIDER=

# Override the model, per provider. These exist because model names rot:
# Groq retired llama-3.3-70b-versatile mid-build, and Google's model list
# still advertises gemini-2.5-flash while the endpoint this app uses returns
# 404 for it. When that happens again the fix should be one line here.
#   list Groq's:   curl -H "Authorization: Bearer $GROQ_API_KEY" \
#                       https://api.groq.com/openai/v1/models
#   list Gemini's: curl -H "Authorization: Bearer $GEMINI_API_KEY" \
#                       https://generativelanguage.googleapis.com/v1beta/openai/models
# CLERK_GEMINI_MODEL=gemini-flash-lite-latest
# CLERK_GROQ_MODEL=qwen/qwen3.8-27b


# ---------------------------------------------------------------------------
# Where the archive lives. Leave it alone unless you mean it.
# ---------------------------------------------------------------------------
# Defaults to server/case-file.sqlite. Point it elsewhere to run against a
# scratch database — which is what the tests do, so that nothing that writes
# can reach the real one.
# CASE_FILE_DB=
