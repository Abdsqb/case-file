# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# sqlite database
server/*.sqlite

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets. .env is NOT tracked; .env.example documents the shape instead.
.env
.env.local
.env.*.local
!.env.example
# A real class schedule is personal data. The repo ships a fictional
# src/data/class-calendar.ics; drop yours in as *.local.ics and it wins.
src/data/*.local.ics

# Dated copies of the archive (npm run db:backup, pre-migration snapshots).
server/backups/

# The study plan (Calendar → Study plan) holds grades. It lives in the
# database; the JSON it was imported from stays on this PC.
*.local.json
